# Copy to .env.local for development. Never commit real values.

# PostgreSQL connection string (see compose.yaml for the local dev database)
DATABASE_URL=postgres://refined:refined@127.0.0.1:5432/refined

# Auth.js session encryption secret, at least 32 characters
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# GitHub OAuth App credentials
# https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub numeric user IDs that may use /admin/
# Find yours: https://api.github.com/users/<username> -> "id"
ADMIN_GITHUB_IDS=

# Secret for POST /webhooks/github deliveries (repo Settings -> Webhooks).
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Additional origin allowed to call this API with credentials (external
# clients such as mobile). The bundled UI is same-origin and needs no entry.
WEB_ORIGIN=http://localhost:5173

# Directory where avatar images are stored (persistent volume in production)
STORAGE_DIR=./storage

# Test database used by the integration test suite (optional; defaults shown)
TEST_DATABASE_URL=postgres://refined:refined@127.0.0.1:5432/refined_test
