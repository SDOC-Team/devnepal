{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens extracted from Figma: DevNepal / UX4G footer component (node 2-15573, Desktop, Light). Logo artwork colors are intentionally excluded.",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#0b3b8b",
        "$description": "Primary brand blue. Link text, logo wordmark, tag labels."
      },
      "primary-deep": {
        "$type": "color",
        "$value": "#001b4f",
        "$description": "Deep navy. Footer bottom strip background."
      },
      "primary-border": {
        "$type": "color",
        "$value": "#90b9ff",
        "$description": "Muted blue border for tag/chip outlines."
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "#cfe3fc",
        "$description": "Light blue. Inverted links and icons on dark backgrounds."
      },
      "primary-surface": {
        "$type": "color",
        "$value": "#f2f7ff",
        "$description": "Very light blue tint for raised surfaces."
      }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#fafafa" },
      "200": { "$type": "color", "$value": "#e5e5e5" },
      "500": { "$type": "color", "$value": "#737373" },
      "700": { "$type": "color", "$value": "#404040" },
      "900": { "$type": "color", "$value": "#171717" }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.neutral.900}",
        "$description": "Headings and titles."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.neutral.700}",
        "$description": "Body copy, subtitles. Most-used text color."
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.500}",
        "$description": "De-emphasised captions."
      },
      "link": { "$type": "color", "$value": "{color.brand.primary}" },
      "on-dark": { "$type": "color", "$value": "#ffffff" },
      "on-dark-muted": { "$type": "color", "$value": "rgba(255, 255, 255, 0.87)" },
      "on-dark-subtle": { "$type": "color", "$value": "{color.neutral.50}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "#ffffff" },
      "raised": { "$type": "color", "$value": "{color.brand.primary-surface}" },
      "inverse": { "$type": "color", "$value": "{color.brand.primary-deep}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.200}" },
      "accent": { "$type": "color", "$value": "{color.brand.primary-border}" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Noto Sans", "system-ui", "sans-serif"],
        "$description": "Primary UI typeface."
      },
      "display": {
        "$type": "fontFamily",
        "$value": ["Raleway", "Noto Sans", "sans-serif"],
        "$description": "Used for nav/tag links."
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "11px" },
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "13px" },
      "lg": { "$type": "dimension", "$value": "14px" },
      "xl": { "$type": "dimension", "$value": "16px" }
    },
    "lineHeight": {
      "tight": { "$type": "dimension", "$value": "14px" },
      "snug": { "$type": "dimension", "$value": "16px" },
      "normal": { "$type": "dimension", "$value": "18px" },
      "relaxed": { "$type": "dimension", "$value": "20px" },
      "loose": { "$type": "dimension", "$value": "22px" },
      "link": { "$type": "dimension", "$value": "24px" }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.lineHeight.normal}",
        "letterSpacing": "0"
      },
      "$description": "Default body text. Most common style in the design."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.lineHeight.snug}",
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "0"
      }
    },
    "link": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.md}",
        "lineHeight": "{font.lineHeight.link}",
        "letterSpacing": "0.5px"
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.lg}",
        "lineHeight": "{font.lineHeight.relaxed}",
        "letterSpacing": "0.1px"
      }
    },
    "headingSm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.lg}",
        "lineHeight": "{font.lineHeight.normal}",
        "letterSpacing": "0"
      }
    },
    "headingMd": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.xl}",
        "lineHeight": "{font.lineHeight.loose}",
        "letterSpacing": "0"
      }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "40px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px", "$description": "Tags, chips, inputs." },
    "md": { "$type": "dimension", "$value": "8px" },
    "full": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Pills and circular avatars."
    }
  }
}
